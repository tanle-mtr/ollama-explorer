# ===== 存储（推荐 GitHub Gists，无需第三方服务） =====
# 在 GitHub Settings → Developer settings → Personal access tokens 生成 token
# 权限选择: gist
# 然后在 Gist 中创建数据文件，获取 Gist ID
GIST_ID=
GH_TOKEN=

# ===== 备选：Upstash Redis（有请求限制） =====
# UPSTASH_REDIS_REST_URL=
# UPSTASH_REDIS_REST_TOKEN=

# ===== 可选：IP 地理信息（ipinfo.io，免费无需 token） =====
GEOIP_TOKEN=

# ===== 可选：探测接口访问令牌（保护 /api/probe 不被滥用，GitHub Actions 定时扫描时需一致） =====
PROBE_TOKEN=
